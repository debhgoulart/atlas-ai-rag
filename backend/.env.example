# ==============================================================================
# Atlas AI Backend — Environment Variables (Render Deployment)
# ==============================================================================

ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME="Atlas AI"
APP_VERSION="0.1.0"

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173", "https://seu-app-atlas-ai.vercel.app"]

DATABASE_URL=postgresql+asyncpg://atlas_user:atlas_password@localhost:5432/atlas_ai_db

# Symmetric encryption master key for user Gemini API keys
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=your_fernet_32_byte_base64_encryption_key_here

# JWT authentication secret key
SECRET_KEY=your_jwt_signing_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Fallback Gemini key (individual user keys stored in DB take precedence)
GEMINI_API_KEY=
GEMINI_API_VERSION=v1beta
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=100
MAX_UPLOAD_SIZE_MB=10
