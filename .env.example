# ==============================================================================
# Atlas AI — Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file into source control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME="Atlas AI"
APP_VERSION="0.1.0"

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# PostgreSQL Database with pgvector
POSTGRES_USER=atlas_user
POSTGRES_PASSWORD=atlas_password
POSTGRES_DB=atlas_ai_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://atlas_user:atlas_password@localhost:5432/atlas_ai_db

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# RAG & Chunking Configuration
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=100
MAX_UPLOAD_SIZE_MB=10

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
