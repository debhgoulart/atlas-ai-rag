# ==============================================================================
# Atlas AI — Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file into source control.
# ==============================================================================

# ==============================================================================
# 1. RENDER (Backend) Environment Variables
# Configure these variables in the Render Dashboard for the backend web service.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME="Atlas AI"
APP_VERSION="0.1.0"

# Backend Host & CORS
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173", "https://seu-app-atlas-ai.vercel.app"]

# PostgreSQL Database with pgvector
DATABASE_URL=postgresql+asyncpg://atlas_user:atlas_password@localhost:5432/atlas_ai_db

# Security & Symmetric Encryption
# Generate a master key via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=your_fernet_32_byte_base64_encryption_key_here
SECRET_KEY=your_jwt_signing_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Gemini Models Configuration (Default fallback, per-user keys are prioritized)
GEMINI_API_KEY=
GEMINI_API_VERSION=v1beta
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# RAG & Chunking Configuration
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=100
MAX_UPLOAD_SIZE_MB=10

# ==============================================================================
# 2. VERCEL (Frontend) Environment Variables
# Configure this variable in the Vercel Dashboard for the frontend deployment.
# ==============================================================================
VITE_API_BASE_URL=https://atlas-ai-backend.onrender.com/api/v1
